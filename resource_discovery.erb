<%
# resource_discovery.erb — updated 2026-07-13
#
# Base: the advanced /var/www/ood/apps/sys/ood-resource-discovery version
# (partition filtering, num_gpus, partition MaxMem/MaxCPU caps, feature-variant
# detection, availability-aware maxima, zero-maintenance GPU labels).
#
# Fixes folded in this revision:
#   * generate_gpu_type_field: emitted help/options/javascript as siblings of
#     gpu_type (multi-heredoc each dedented to col 0). Now one properly-nested
#     block so the static <select> carries its own options.
#   * parse_slurm_time: 'infinite'/'unlimited' matched case-insensitively BEFORE
#     the empty check (previously returned 0 and dropped the partition); two-
#     component times parsed as MM:SS (sub-hour -> 1) instead of HH:MM; sub-hour
#     HH:MM:SS rounds up to 1.
#   * num_memory max uses .floor (was .round) so it never advertises more GB
#     than a node provides; floored to at least 1.
#   * CfgTRES mem parsing also handles the T (terabyte) unit.
#   * Slurm queries cached for 5 minutes (Rails.cache) so scontrol/sinfo do not
#     run on every form render.
#   * sinfo called with -h (no header); JSON embedded in single-quoted YAML
#     scalars is escaped ('' ) defensively.
#   * Removed the leftover DEBUG constant (now a local var) and the TEST-ONLY
#     unavailable-gpu line.
#
# Method names/signatures are unchanged, so consuming forms keep calling
# generate_partition_field / generate_gpu_type_field / generate_num_cores_field /
# generate_num_memory_field / generate_num_hours_field / generate_num_gpus_field
# exactly as before. Apps set @partition_filter = :gpu (or :cpu) before the
# include.
require 'open3'
require 'set'
require 'json'

# Capture command output or return empty string on failure
def capture_stdout(cmd)
  stdout, status = Open3.capture2(cmd)
  status.success? ? stdout : ''
rescue => _e
  ''
end

# Cache Slurm queries for 5 minutes so form renders don't hammer slurmctld.
# Falls back to a direct call when Rails.cache isn't available.
def cached_capture(key, cmd)
  if defined?(Rails) && Rails.respond_to?(:cache) && Rails.cache
    Rails.cache.fetch("resource_discovery/#{key}", expires_in: 300) { capture_stdout(cmd) }
  else
    capture_stdout(cmd)
  end
rescue => _e
  capture_stdout(cmd)
end

# Default partition filter; calling form.yml.erb can override before the include
# by setting `@partition_filter = :cpu` (or :gpu). Used as the default for the
# four generate_* helpers so app authors only set it in one place.
@partition_filter ||= :all

# Shared partition/QOS rules (partition_qos.rb, deployed next to this partial).
# If it is missing, the built-in public partition list below is used and the
# "Request priority start" checkbox is left alone by form.js.
@partition_qos_path ||= '/etc/ood/config/apps/dashboard/batch_connect/partials/partition_qos.rb'
begin
  load @partition_qos_path
rescue LoadError, StandardError => _e
  # Fall back to built-in defaults.
end

# Public (shared) partitions. Any user-accessible partition not listed here is
# treated as a lab partition and is always shown under the :cpu filter, even if
# it contains GPU nodes.
@public_partitions ||= defined?(PartitionQos) ? PartitionQos.public_partitions : %w[batch gpu preempt blackwell]

def lab_partition?(partition)
  !@public_partitions.include?(partition)
end

# Partitions shown under every filter (:all, :cpu, :gpu), whether or not they
# contain GPU nodes. All users have access to these.
@always_shown_partitions ||= %w[preempt]

# Public partitions that accept both CPU and GPU jobs. Like lab partitions, they
# offer "None (CPU only)" in the GPU type list under :all.
@mixed_use_partitions ||= %w[preempt]

# Partitions with GPU nodes that should also offer a CPU-only choice.
def cpu_choice_partition?(partition)
  lab_partition?(partition) || @mixed_use_partitions.include?(partition)
end

@nodes_out = cached_capture('nodes', 'scontrol show node --oneliner')

# Capture partition time limits
@partitions_info = cached_capture('partitions', 'sinfo -h -o "%P %l"')

# Capture partition scheduling caps (MaxMemPerNode, MaxCPUsPerNode).
# Node CfgTRES reports physical mem/cpus, but the partition can cap what's
# actually schedulable (e.g. batch nodes have 1008 GB but MaxMemPerNode=503 GB).
@partitions_detail = cached_capture('partitions_detail', 'scontrol show partition --oneliner')
@partition_max_mem_mb = {}
@partition_max_cpus   = {}

@partitions_detail.each_line do |line|
  name = line[/\bPartitionName=(\S+)/, 1]
  next unless name

  if (m = line.match(/\bMaxMemPerNode=(\S+)/))
    raw = m[1]
    unless raw.nil? || raw.upcase.start_with?('UNLIMITED')
      mb = raw.to_i
      @partition_max_mem_mb[name] = mb if mb > 0
    end
  end

  if (m = line.match(/\bMaxCPUsPerNode=(\S+)/))
    raw = m[1]
    unless raw.nil? || raw.upcase.start_with?('UNLIMITED')
      n = raw.to_i
      @partition_max_cpus[name] = n if n > 0
    end
  end
end

# Parsing the SLURM output
@detected_types = Set.new
@detected_gres_names = Set.new

# Per-partition tracking
@detected_by_partition    = Hash.new { |h, k| h[k] = Set.new }

# Core/CPU tracking per partition AND GPU type
@max_cores_by_partition_and_gpu   = Hash.new { |h, k| h[k] = Hash.new(0) }

# Memory tracking per partition AND GPU type (in MB)
@max_memory_by_partition_and_gpu  = Hash.new { |h, k| h[k] = Hash.new(0) }

# GPU count tracking per partition AND GPU type
@max_gpus_by_partition_and_gpu = Hash.new { |h, k| h[k] = Hash.new(0) }

# Track node availability per GPU type (for unavailability warnings)
@gpu_type_node_states = Hash.new { |h, k| h[k] = { available: 0, unavailable: 0 } }

# Time limit tracking per partition (in hours)
@max_hours_by_partition = Hash.new(0)

# Helper to determine if a node state is available for scheduling
def node_is_available?(state_str)
  return false if state_str.nil? || state_str.strip.empty?

  # Convert to uppercase for case-insensitive matching
  state = state_str.upcase

  # States that make a node unavailable for scheduling (per SLURM scontrol/sinfo
  # state docs). RESERVED/RESV are intentionally NOT here — reserved nodes are
  # still schedulable for jobs in the reservation.
  unavailable_states = [
    'BLOCKED', 'CLOUD', 'COMP', 'COMPLETING',
    'DOWN', 'DRAIN', 'DRAINED', 'DRAINING',
    'FAIL', 'FAILING', 'FUTURE', 'FUTR',
    'MAINT', 'NO_RESPOND', 'NOT_RESPONDING', 'NPC',
    'PERFCTRS', 'PLANNED',
    'POWER_DOWN', 'POWERING_DOWN', 'POWERED_DOWN', 'POWERING_UP',
    'REBOOT_ISSUED', 'REBOOT_REQUESTED',
    'UNK', 'UNKNOWN'
  ]

  # Check if any unavailable state is present
  unavailable_states.any? { |s| state.include?(s) } ? false : true
end

# Helper to convert a SLURM time-limit string to whole hours.
# Formats: infinite/UNLIMITED, D-HH:MM:SS, D-HH, HH:MM:SS, MM:SS.
# Sub-hour limits round up to 1 so the partition still appears in the form
# (bc_num_hours can't represent less than an hour anyway).
def parse_slurm_time(time_str)
  return 0 if time_str.nil? || time_str.strip.empty?

  # "infinite" / "unlimited" -> treat as a very large number (30 days = 720h).
  # Must be checked case-insensitively BEFORE anything else.
  return 720 if time_str =~ /infinite|unlimited/i

  if time_str.include?('-')
    # Has days component: D-HH[:MM:SS]
    days_part, time_part = time_str.split('-', 2)
    days = days_part.to_i

    time_components = time_part.to_s.split(':').map(&:to_i)
    hours = days * 24 + (time_components[0] || 0)
    # Ignore minutes and seconds for simplicity
  else
    # No days, just time
    time_components = time_str.split(':').map(&:to_i)
    if time_components.length == 3
      # HH:MM:SS — round a sub-hour limit up to 1 so it isn't dropped
      hours = time_components[0] > 0 ? time_components[0] : 1
    elsif time_components.length == 2
      # MM:SS — always under an hour; round up to 1
      hours = 1
    else
      hours = time_components[0] || 0
    end
  end

  hours
end

@partitions_info.each_line do |line|
  next if line.include?('PARTITION') # Skip header (also handled by sinfo -h)

  parts = line.strip.split(/\s+/)
  next if parts.length < 2

  partition_name = parts[0].gsub('*', '') # Remove default marker
  time_limit = parts[1]

  hours = parse_slurm_time(time_limit)
  # Take the max across duplicate lines for the same partition
  @max_hours_by_partition[partition_name] = hours if hours > @max_hours_by_partition[partition_name]
end

# Collect user-accessible partition names (sinfo without --all filters by access)
@user_partitions = []
@partitions_info.each_line do |line|
  next if line.include?('PARTITION')
  parts = line.strip.split(/\s+/)
  next if parts.length < 2
  partition_name = parts[0].gsub('*', '')
  @user_partitions << partition_name unless @user_partitions.include?(partition_name)
end

@nodes_out.each_line do |line|
  # Gres=gpu:<type>:<count>
  if (m = line.match(/\bGres=gpu:([[:alnum:]_.-]+)/))
    type = m[1]
    if type && type != 'null'
      @detected_types << type
      @detected_gres_names << type
    end
  end

  # Features may contain GPU-specific variants such as a100-40G / a100-80G.
  feats_available = line[/\bAvailableFeatures=(\S+)/, 1]
  feats_active    = line[/\bActiveFeatures=(\S+)/, 1]
  feats_legacy    = line[/\bFeature(?:s)?=(\S+)/, 1]
  feature_tokens = [feats_available, feats_active, feats_legacy]
                   .compact
                   .flat_map { |value| value.split(',') }
                   .uniq
  gpu_feature_variants = feature_tokens.select { |token| token.match?(/\A[[:alnum:]_.+]+-\d+[[:alpha:]]+\z/) }
  gpu_feature_variants.each { |variant| @detected_types << variant }

  # Extract node state for availability tracking
  node_state = line[/\bState=(\S+)/, 1]
  is_available = node_is_available?(node_state)

  # Partition list for this node
  parts_str = line[/\bPartitions=(\S+)/, 1]
  parts = parts_str ? parts_str.split(',') : []

  # Extract CPU/Core information. Prefer CPUEfctv (schedulable) but fall back to
  # CPUTot on older Slurm that doesn't report CPUEfctv.
  cores = (line[/\bCPUEfctv=(\d+)/, 1] || line[/\bCPUTot=(\d+)/, 1]).to_i

  # Extract Memory information from CfgTRES (what's actually schedulable)
  # Format: CfgTRES=cpu=64,mem=514943M,billing=64 or mem=1500G / mem=2T
  cfg_tres = line[/\bCfgTRES=([^\s]+)/, 1]
  memory_mb = 0
  if cfg_tres && cfg_tres.include?('mem=')
    mem_match = cfg_tres.match(/mem=(\d+(?:\.\d+)?)([MGT])/)
    if mem_match
      mem_value = mem_match[1].to_f
      mem_unit = mem_match[2]
      # Convert to MB for consistent storage
      memory_mb = case mem_unit
                  when 'T' then (mem_value * 1024 * 1024).to_i
                  when 'G' then (mem_value * 1024).to_i
                  else mem_value.to_i
                  end
    end
  end

  # Determine GPU type(s) for this node
  gpu_types_on_node = Set.new
  gpu_count_on_node = 0

  # Check for GPU in Gres field
  if (m = line.match(/\bGres=gpu:([[:alnum:]_.-]+)(?::(\d+))?/))
    gpu_type = m[1]
    if gpu_type && gpu_type != 'null'
      gpu_types_on_node << gpu_type
      gpu_count_on_node = m[2].to_i if m[2]
    end
  end

  gpu_feature_variants.each { |variant| gpu_types_on_node << variant }

  # If no GPUs detected, this is a "none" node
  if gpu_types_on_node.empty?
    gpu_types_on_node << 'none'
  end

  # Track node availability for each GPU type on this node
  gpu_types_on_node.each do |gpu_type|
    next if gpu_type == 'none'  # Don't track availability for non-GPU nodes

    if is_available
      @gpu_type_node_states[gpu_type][:available] += 1
    else
      @gpu_type_node_states[gpu_type][:unavailable] += 1
    end
  end

  # Track cores and memory by partition AND GPU type. Skip nodes that are not
  # currently schedulable so down/drained/maint nodes don't inflate the cap
  # users see (e.g. batch's pax072/073 advertising 1008 GB while DOWN+DRAIN).
  if is_available
    parts.each do |p|
      gpu_types_on_node.each do |gpu_type|
        if cores > @max_cores_by_partition_and_gpu[p][gpu_type]
          @max_cores_by_partition_and_gpu[p][gpu_type] = cores
        end
        if memory_mb > @max_memory_by_partition_and_gpu[p][gpu_type]
          @max_memory_by_partition_and_gpu[p][gpu_type] = memory_mb
        end
        if gpu_type != 'none' && gpu_count_on_node > @max_gpus_by_partition_and_gpu[p][gpu_type]
          @max_gpus_by_partition_and_gpu[p][gpu_type] = gpu_count_on_node
        end
      end
    end
  end

  # Record per-partition types
  if (m = line.match(/\bGres=gpu:([[:alnum:]_.-]+)/))
    type = m[1]
    if type && type != 'null'
      parts.each { |p| @detected_by_partition[p] << type }
    end
  end

  gpu_feature_variants.each do |variant|
    parts.each { |p| @detected_by_partition[p] << variant }
  end
end

# If a partition has feature variants like a100-40G/a100-80G, prefer them over the
# generic base GPU id (a100) for display and selection.
variant_bases = @detected_types
  .select { |gpu_type| gpu_type.include?('-') }
  .map { |gpu_type| gpu_type.split('-', 2).first }
  .to_set

@detected_types.subtract(variant_bases)
@detected_by_partition.each_value do |types|
  local_variant_bases = types
    .select { |gpu_type| gpu_type.include?('-') }
    .map { |gpu_type| gpu_type.split('-', 2).first }
    .to_set
  types.subtract(local_variant_bases)
end

# Flag if dynamic discovery failed (no types detected)
@dynamic_failed = @detected_types.empty?

# Determine which GPU types are completely unavailable (all nodes down/drained)
@unavailable_gpu_types = Set.new
@gpu_type_node_states.each do |gpu_type, counts|
  # If this GPU type has nodes but ALL are unavailable, mark it
  if counts[:available] == 0 && counts[:unavailable] > 0
    @unavailable_gpu_types << gpu_type
  end
end

# Zero-maintenance GPU labels derived directly from SLURM identifiers.
# This avoids keeping a static map in sync as new GPU types are added.
def gpu_display_label(gpu_type)
  return gpu_type if gpu_type.nil? || gpu_type.empty?

  parts = gpu_type.split(/[-_]/)
  return gpu_type.upcase if parts.empty?

  ([parts.first.upcase] + parts.drop(1)).join(' ')
end

# Cluster-wide default options
@options = []
if @detected_types.empty?
  # No GPUs detected anywhere: keep a CPU-only sentinel.
  @options << ['none', 'none']
else
  # GPUs detected: offer 'Any' first, then each concrete GPU type/feature.
  @options << ['Any', 'any']
  remaining = @detected_types.to_a
  remaining.sort_by! { |t| gpu_display_label(t) }
  remaining.each do |t|
    label = gpu_display_label(t)
    @options << [label, t]
  end
end

# Build partition-aware options map using the same labeling/ordering rules
@partition_options_map = {}

build_opts = lambda do |types_set, partition|
  local = []

  if types_set.empty?
    local << ['none', 'none']
  else
    # Under :all, lab partitions (and mixed-use partitions such as preempt)
    # that contain GPU nodes also offer a CPU-only choice, listed first so it
    # is the default, so users can run CPU jobs there without requesting a GPU.
    if @partition_filter == :all && cpu_choice_partition?(partition)
      local << ['None (CPU only)', 'none']
    end
    local << ['Any', 'any']
    remaining_local = types_set.to_a
    remaining_local.sort_by! { |t| gpu_display_label(t) }
    remaining_local.each do |t|
      label = gpu_display_label(t)
      local << [label, t]
    end
  end
  local
end

@all_partitions = @user_partitions
@all_partitions.each do |p|
  @partition_options_map[p] = build_opts.call(@detected_by_partition[p], p)
end

# Also keep a cluster-wide default
@partition_options_map['all'] = @options

# Generate the complete gpu_type field definition.
# NOTE: built as one properly-nested block. Do NOT go back to concatenating
# separate <<~ heredocs — each squiggly heredoc dedents to column 0, which makes
# help/options/javascript siblings of gpu_type instead of children.
def generate_gpu_type_field
  # Build a map of unavailable GPU types with their friendly labels for warnings
  unavailable_map = {}
  @unavailable_gpu_types.each do |gpu_type|
    unavailable_map[gpu_type] = gpu_display_label(gpu_type)
  end

  # JSON lives inside single-quoted YAML scalars; escape ' as '' defensively.
  partition_json   = @partition_options_map.to_json.gsub("'", "''")
  unavailable_json = unavailable_map.to_json.gsub("'", "''")

  field_yaml = +''
  field_yaml << "gpu_type:\n"
  field_yaml << "  widget: \"select\"\n"
  field_yaml << "  label: \"GPU architecture\"\n"
  field_yaml << "  cacheable: false\n"
  field_yaml << "  html_options:\n"
  field_yaml << "    data:\n"
  field_yaml << "      partition_options: '#{partition_json}'\n"
  field_yaml << "      unavailable_gpus: '#{unavailable_json}'\n"
  # Only show help text when dynamic discovery failed; the auto-detected list
  # is noise during normal operation.
  if @dynamic_failed
    field_yaml << "  help: \"Failed to dynamically obtain GPU options from Slurm on this host. Showing minimal defaults.\"\n"
  end
  field_yaml << "  options:\n"
  @options.each do |label, value|
    field_yaml << "    - [ \"#{label}\", \"#{value}\" ]\n"
  end
  field_yaml << "  javascript: \"form.js\"\n"

  field_yaml
end

# Clamp aggregated per-partition values by the partition-level scheduling caps
# (MaxMemPerNode, MaxCPUsPerNode from `scontrol show partition`). Must happen
# before we compute 'any' / 'all' / @global_max_* so those reflect what's
# actually schedulable.
@max_memory_by_partition_and_gpu.each do |partition, gpu_hash|
  cap = @partition_max_mem_mb[partition]
  next unless cap
  gpu_hash.each { |gpu, val| gpu_hash[gpu] = cap if val > cap }
end

@max_cores_by_partition_and_gpu.each do |partition, gpu_hash|
  cap = @partition_max_cpus[partition]
  next unless cap
  gpu_hash.each { |gpu, val| gpu_hash[gpu] = cap if val > cap }
end

# CPU-only jobs in a lab or mixed-use partition with GPU nodes can land on any
# node in it, GPU nodes included, so their 'none' caps are the max across all
# node types.
[@max_cores_by_partition_and_gpu, @max_memory_by_partition_and_gpu].each do |map|
  map.each do |partition, gpu_hash|
    next unless cpu_choice_partition?(partition) && !@detected_by_partition[partition].empty?
    next if gpu_hash.empty?
    gpu_hash['none'] = gpu_hash.values.max
  end
end

# Compute "any" GPU values for each partition (max across all GPU types)
# Also compute global fallback values for 'all' partition
@max_cores_by_partition_and_gpu.each do |partition, gpu_hash|
  if gpu_hash.any?
    @max_cores_by_partition_and_gpu[partition]['any'] = gpu_hash.values.max
  end
end

@max_memory_by_partition_and_gpu.each do |partition, gpu_hash|
  if gpu_hash.any?
    @max_memory_by_partition_and_gpu[partition]['any'] = gpu_hash.values.max
  end
end

@max_gpus_by_partition_and_gpu.each do |partition, gpu_hash|
  if gpu_hash.any?
    @max_gpus_by_partition_and_gpu[partition]['any'] = gpu_hash.values.max
  end
end

# Compute global max values for 'all' partition fallback
all_cores = @max_cores_by_partition_and_gpu.values.flat_map(&:values)
all_memory = @max_memory_by_partition_and_gpu.values.flat_map(&:values)
all_gpus = @max_gpus_by_partition_and_gpu.values.flat_map(&:values)
all_hours = @max_hours_by_partition.values

@global_max_cores = all_cores.reject(&:zero?).max || 64
@global_max_memory = all_memory.reject(&:zero?).max || 128000
@global_max_gpus = all_gpus.reject(&:zero?).max || 1
@global_max_hours = all_hours.reject(&:zero?).max || 72  # Default to 72 hours (3 days) if no partitions found

# Set 'all' partition defaults (use global max for 'any' and 'none')
@max_cores_by_partition_and_gpu['all']['any'] = @global_max_cores
@max_cores_by_partition_and_gpu['all']['none'] = @global_max_cores
@max_memory_by_partition_and_gpu['all']['any'] = @global_max_memory
@max_memory_by_partition_and_gpu['all']['none'] = @global_max_memory
@max_gpus_by_partition_and_gpu['all']['any'] = @global_max_gpus
@max_gpus_by_partition_and_gpu['all']['none'] = 0
@max_hours_by_partition['all'] = @global_max_hours

# Select partitions matching the filter (:all, :gpu, :cpu).
# :cpu keeps CPU-only partitions plus all lab partitions (GPU or not).
# @always_shown_partitions (e.g. preempt) are kept under every filter.
def partitions_for_filter(filter)
  @user_partitions.select do |p|
    next true if @always_shown_partitions.include?(p)
    has_gpu = !@detected_by_partition[p].empty?
    case filter
    when :gpu then has_gpu
    when :cpu then !has_gpu || lab_partition?(p)
    else true
    end
  end
end

# Scope a partition->gpu->value map to the filtered partitions.
# Preserves the 'all' fallback so JS lookups still work.
def scope_partition_gpu_map(map, filter)
  allowed = partitions_for_filter(filter)
  scoped = map.select { |k, _| allowed.include?(k) || k == 'all' }
  scoped
end

def scope_partition_map(map, filter)
  allowed = partitions_for_filter(filter)
  map.select { |k, _| allowed.include?(k) || k == 'all' }
end

# Generate the complete num_gpus field definition
def generate_num_gpus_field(filter: @partition_filter)
  scoped_map = scope_partition_gpu_map(@max_gpus_by_partition_and_gpu, filter)
  partition_max_values = scoped_map.reject { |k, _| k == 'all' }.values.flat_map(&:values)
  scoped_max = partition_max_values.reject(&:zero?).max || 1
  scoped_map['all'] = { 'any' => scoped_max, 'none' => 0 }
  scoped_json = scoped_map.to_json.gsub("'", "''")

  field_yaml = <<~YAML
  num_gpus:
    widget: "number_field"
    label: "Number of GPUs"
    cacheable: false
    display: true
    value: 1
    min: 1
    max: #{scoped_max}
    step: 1
    html_options:
      data:
        partition_gpu_max_gpus: '#{scoped_json}'
        partition_filter: '#{filter}'
    help: "Number of GPUs to allocate on one node. Max varies by partition and GPU type (Maximum: #{scoped_max} GPUs)."
  YAML

  field_yaml
end

# Generate the complete num_cores field definition
def generate_num_cores_field(filter: @partition_filter)
  scoped_map = scope_partition_gpu_map(@max_cores_by_partition_and_gpu, filter)
  partition_max_values = scoped_map.reject { |k, _| k == 'all' }.values.flat_map(&:values)
  scoped_max = partition_max_values.reject(&:zero?).max || @global_max_cores
  scoped_map['all'] = { 'any' => scoped_max, 'none' => scoped_max }
  scoped_json = scoped_map.to_json.gsub("'", "''")
  varies_by = filter == :cpu ? 'partition' : 'partition and GPU type'

  field_yaml = <<~YAML
  num_cores:
    widget: "number_field"
    label: "Number of CPU cores"
    cacheable: false
    value: 1
    min: 1
    max: #{scoped_max}
    step: 1
    html_options:
      data:
        partition_gpu_max_cores: '#{scoped_json}'
        partition_filter: '#{filter}'
    help: "Number of CPU cores/threads to allocate. Max varies by #{varies_by} (Maximum: #{scoped_max} cores)."
  YAML

  field_yaml
end

# Generate the complete num_memory field definition
def generate_num_memory_field(filter: @partition_filter)
  scoped_map = scope_partition_gpu_map(@max_memory_by_partition_and_gpu, filter)
  partition_max_values = scoped_map.reject { |k, _| k == 'all' }.values.flat_map(&:values)
  scoped_max_mb = partition_max_values.reject(&:zero?).max || @global_max_memory
  scoped_map['all'] = { 'any' => scoped_max_mb, 'none' => scoped_max_mb }
  scoped_json = scoped_map.to_json.gsub("'", "''")
  # floor, not round: rounding up would advertise more GB than a node provides
  max_memory_gb = [(scoped_max_mb / 1024.0).floor, 1].max
  varies_by = filter == :cpu ? 'partition' : 'partition and GPU type'

  field_yaml = <<~YAML
  num_memory:
    widget: "number_field"
    label: "Memory per node (GB)"
    cacheable: false
    display: true
    value: 4
    min: 1
    max: #{max_memory_gb}
    step: 1
    html_options:
      data:
        partition_gpu_max_memory: '#{scoped_json}'
        partition_filter: '#{filter}'
    help: "Amount of memory to allocate per node in GB. Max varies by #{varies_by} (Maximum: #{max_memory_gb} GB)."
  YAML

  field_yaml
end

# Generate the complete bc_num_hours field definition
def generate_num_hours_field(filter: @partition_filter)
  scoped_map = scope_partition_map(@max_hours_by_partition, filter)
  partition_max_values = scoped_map.reject { |k, _| k == 'all' }.values
  scoped_max = partition_max_values.reject(&:zero?).max || @global_max_hours
  scoped_map['all'] = scoped_max
  scoped_json = scoped_map.to_json.gsub("'", "''")

  field_yaml = <<~YAML
  bc_num_hours:
    cacheable: false
    value: 1
    min: 1
    max: #{scoped_max}
    step: 1
    html_options:
      data:
        partition_max_hours: '#{scoped_json}'
    help: "Number of hours to run the job. Max varies by partition (Maximum: #{scoped_max} hours)."
  YAML

  field_yaml
end

# Generate the partition field definition using user-accessible partitions
# filter: :all (default), :gpu (GPU partitions only), :cpu (CPU-only partitions
# plus all lab partitions)
def generate_partition_field(filter: @partition_filter)
  filtered = partitions_for_filter(filter)
  default_partition =
    case filter
    when :gpu
      filtered.include?('gpu') ? 'gpu' : filtered.first
    when :cpu, :all
      filtered.include?('batch') ? 'batch' : filtered.first
    else
      filtered.first
    end

  field_yaml = <<~YAML
  partition:
    widget: "select"
    label: "Partition"
    cacheable: false
    javascript: "form.js"
    value: "#{default_partition}"
    help: "Partitions available to you (dynamically detected via SLURM)."
  YAML

  # Tell form.js which partitions allow "Request priority start"
  # (--qos=interactive). Only emitted when partition_qos.rb is loaded.
  if defined?(PartitionQos)
    allowed = filtered.select { |p| PartitionQos.interactive_allowed?(p, @public_partitions) }
    allowed_json = allowed.to_json.gsub("'", "''")
    field_yaml += "  html_options:\n"
    field_yaml += "    data:\n"
    field_yaml += "      interactive_qos_partitions: '#{allowed_json}'\n"
  end

  field_yaml += "  options:\n"

  filtered.each do |p|
    field_yaml += "    - [\"#{p}\", \"#{p}\"]\n"
  end

  field_yaml
end

